{
  "name": "triadichrome",
  "private": true,
  "version": "7.2.1",
  "description": "Triadichrome Chrome Extension development environment",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:ui": "vite --host 127.0.0.1 --port 4173 --strictPort",
    "build": "npm run typecheck && node scripts/build.mjs && npm run samples:generate",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit --pretty false",
    "test": "node scripts/test-files.mjs && node --test tests/repository-workflow.test.mjs tests/screen-data-model.test.mjs && npm run samples:check",
    "samples:generate": "node scripts/generate-sample-plan.mjs",
    "samples:check": "node scripts/generate-sample-plan.mjs --check",
    "test:ui": "npm run build && playwright test",
    "test:ui:colors": "npm run build && playwright test colors.spec.ts",
    "test:ui:report": "playwright show-report",
    "setup:hooks": "node scripts/setup-hooks.mjs",
    "check:hooks": "node scripts/check-hooks.mjs",
    "check:version": "node scripts/check-version.mjs",
    "version:check-staged": "node scripts/check-version.mjs --staged",
    "version:next": "node scripts/version-next.mjs",
    "check:release": "node scripts/check-release.mjs",
    "verify": "npm run check:hooks && npm run build && npm test && npm run check:version",
    "verify:full": "npm run verify && playwright test",
    "verify:release": "npm run verify && npm run check:release"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sql.js": "1.14.2"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/chrome": "0.0.326",
    "@types/node": "24.13.4",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sql.js": "1.4.11",
    "@vitejs/plugin-react": "5.2.0",
    "esbuild": "0.28.2",
    "pixelmatch": "7.2.0",
    "pngjs": "7.0.0",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  }
}
