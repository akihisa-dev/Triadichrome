{
  "name": "triadichrome",
  "private": true,
  "version": "7.9.6",
  "description": "Triadichrome Chrome Extension development environment",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run data-map:generate && vite",
    "dev:ui": "npm run data-map:generate && vite --host 127.0.0.1 --port 4173 --strictPort",
    "build": "npm run typecheck && node scripts/build.mjs && npm run samples:generate",
    "preview": "vite preview",
    "typecheck": "npm run data-map:generate && tsc --noEmit --pretty false",
    "test": "npm run data-map:check && node scripts/test-files.mjs && node --test tests/repository-workflow.test.mjs tests/screen-data-model.test.mjs tests/data-map-generation.test.mjs tests/mechanism-map.test.mjs tests/sqlite-runtime.test.mjs && npm run samples:check",
    "samples:generate": "node scripts/generate-sample-plan.mjs",
    "samples:check": "node scripts/generate-sample-plan.mjs --check",
    "test:ui": "npm run build && playwright test",
    "test:ui:colors": "npm run build && playwright test colors.spec.ts",
    "test:ui:report": "playwright show-report",
    "setup:hooks": "node scripts/setup-hooks.mjs",
    "check:hooks": "node scripts/check-hooks.mjs",
    "check:version": "node scripts/check-version.mjs",
    "version:check-staged": "node scripts/check-version.mjs --staged",
    "version:next": "node scripts/version-next.mjs",
    "check:release": "node scripts/check-release.mjs",
    "verify": "npm run check:hooks && npm run check:samples && npm run build && npm test && npm run check:version",
    "verify:full": "npm run verify && playwright test",
    "verify:release": "npm run verify && npm run check:release",
    "data-map:generate": "node scripts/data-map.mjs",
    "data-map:check": "node scripts/data-map.mjs --check",
    "data-map:review": "node scripts/data-map.mjs --review",
    "mechanism-map:review": "node scripts/data-map.mjs --review-mechanisms",
    "check:samples": "node scripts/check-samples.mjs"
  },
  "dependencies": {
    "@sqlite.org/sqlite-wasm": "3.53.4-build2",
    "exceljs": "4.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/chrome": "0.0.326",
    "@types/node": "24.13.4",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "esbuild": "0.28.2",
    "pixelmatch": "7.2.0",
    "pngjs": "7.0.0",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "jszip": "3.10.2"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
