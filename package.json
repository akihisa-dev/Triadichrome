{
  "name": "triadichrome",
  "private": true,
  "version": "1.1.7",
  "description": "Triadichrome Chrome Extension development environment",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:ui": "vite --host 127.0.0.1 --port 4173 --strictPort",
    "build": "npm run typecheck && node scripts/build.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit --pretty false",
    "test": "node scripts/test-files.mjs",
    "test:ui": "npm run build && playwright test",
    "test:ui:report": "playwright show-report"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "sql.js": "^1.14.2"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/chrome": "^0.0.326",
    "@types/node": "^24.3.0",
    "@types/pngjs": "6.0.5",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^5.0.2",
    "pixelmatch": "7.2.0",
    "pngjs": "7.0.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.2"
  }
}
